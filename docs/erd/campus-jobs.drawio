r=#ffffff;" edge="1" parent="1" source="student" target="apply"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="applyn" value="N" style="startArrow=none;endArrow=none;html=1;fontSize=17;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="apply" target="application"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="receive" value="รับใบสมัคร" style="shape=rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=16;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1360" y="410" width="125" height="95" as="geometry"/></mxCell><mxCell id="receive1" value="1" style="startArrow=none;endArrow=none;html=1;fontSize=17;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="job" target="receive"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="receiven" value="N" style="startArrow=none;endArrow=none;html=1;fontSize=17;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="receive" target="application"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="post" value="ประกาศ" style="shape=rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=16;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1690" y="930" width="125" height="95" as="geometry"/></mxCell><mxCell id="post1" value="1" style="startArrow=none;endArrow=none;html=1;fontSize=17;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="employer" target="post"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="postn" value="N" style="startArrow=none;endArrow=none;html=1;fontSize=17;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="post" target="job"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="classify" value="จัดประเภท" style="shape=rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=16;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1300" y="910" width="125" height="95" as="geometry"/></mxCell><mxCell id="classify1" value="1" style="startArrow=none;endArrow=none;html=1;fontSize=17;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="category" target="classify"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="classifyn" value="N" style="startArrow=none;endArrow=none;html=1;fontSize=17;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="classify" target="job"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="save" value="บันทึกงาน" style="shape=rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=16;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1000" y="90" width="140" height="95" as="geometry"/></mxCell><mxCell id="save_student" value="M" style="startArrow=none;endArrow=none;html=1;fontSize=17;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="student" target="save"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="380" y="120"/></Array></mxGeometry></mxCell><mxCell id="save_job" value="N" style="startArrow=none;endArrow=none;html=1;fontSize=17;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="save" target="job"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1750" y="120"/></Array></mxGeometry></mxCell><mxCell id="notes" value="คำอธิบาย&lt;br&gt;สี่เหลี่ยม = Entity | รูปเพชร = Relationship&lt;br&gt;วงรี = Attribute | ขีดเส้นใต้ = Key Attribute&lt;br&gt;วงรีสองชั้น = Multivalued Attribute&lt;br&gt;1:N = หนึ่งต่อหลาย | M:N = หลายต่อหลาย&lt;br&gt;&lt;br&gt;APPLICATION.status: Pending, Reviewing, Accepted, Rejected&lt;br&gt;JOB.status: Open, Closed | hourly_wage: บาทต่อชั่วโมง&lt;br&gt;resume_url: ลิงก์ Resume | password_hash: รหัสผ่านที่แฮชแล้ว&lt;br&gt;&lt;br&gt;แผนภาพเชิงแนวคิดมี 5 Entity หลัก&lt;br&gt;แปลงเป็น 8 ตาราง: 5 ตารางหลัก + STUDENT_SKILL + JOB_SKILL + SAVED_JOB&lt;br&gt;แยกทักษะเป็นหนึ่งทักษะต่อแถว เพื่อรองรับ 1NF&lt;br&gt;FK เพิ่มในขั้นแปลงเป็นตาราง ไม่แสดงซ้ำในแผนภาพนี้&lt;br&gt;APPLICATION กำหนด UNIQUE(student_id, job_id) ป้องกันสมัครซ้ำ&lt;br&gt;SAVED_JOB ใช้คีย์คู่ (student_id, job_id) ป้องกันบันทึกซ้ำ" style="shape=text;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=16;strokeWidth=1.5;strokeColor=none;align=left;verticalAlign=top;fontSize=17;" vertex="1" parent="1"><mxGeometry x="70" y="920" width="720" height="480" as="geometry"/></mxCell><mxCell id="saved_at" value="saved_at" style="ellipse;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=16;" vertex="1" parent="1"><mxGeometry x="1190" y="100" width="150" height="60" as="geometry"/></mxCell><mxCell id="saved_at_edge" style="startArrow=none;endArrow=none;" edge="1" parent="1" source="save" target="saved_at"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
